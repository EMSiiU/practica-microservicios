# ==============================================================================
# CONFIGURACIÓN GLOBAL Y SEGURIDAD COMPARTIDA (TODOS LOS SERVICIOS)
# ==============================================================================
# Secreto compartido para firmar y verificar tokens JWT HS256 (1 hora de vigencia)
JWT_SECRET=clave_secreta_super_segura_tienda_2026

# Token interno para comunicación servidor-a-servidor (Header: X-Service-Token)
X_SERVICE_TOKEN=token_interno_servicios_tienda_2026

# Origen permitido para CORS en las APIs consumidas desde el navegador
CORS_ORIGIN=http://localhost:4200

# ==============================================================================
# URLs INTERNAS ENTRE MICROSERVICIOS (DENTRO DE DOCKER Y KUBERNETES)
# ==============================================================================
API_USUARIOS_URL=http://api-usuarios:8001
API_PRODUCTOS_URL=http://api-productos:8002
API_ENVIOS_URL=http://api-envios:8003
API_INVENTARIO_URL=http://api-inventario:8004
API_CARRITO_URL=http://api-carrito:8005
API_PEDIDOS_URL=http://api-pedidos:8006
API_PAGOS_URL=http://api-pagos:8007
API_RESENAS_URL=http://api-resenas:8008

# ==============================================================================
# PUERTOS DE CADA SERVICIO
# ==============================================================================
PORT_USUARIOS=8001
PORT_PRODUCTOS=8002
PORT_ENVIOS=8003
PORT_INVENTARIO=8004
PORT_CARRITO=8005
PORT_PEDIDOS=8006
PORT_PAGOS=8007
PORT_RESENAS=8008
PORT_FRONTEND=4200

# ==============================================================================
# BASES DE DATOS (POSTGRESQL Y MONGODB)
# ==============================================================================
# PostgreSQL (Integrante 3: api-pedidos y api-pagos)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tienda_admin
POSTGRES_PASSWORD=tienda_pass_2026
POSTGRES_DB_PEDIDOS=db_pedidos
POSTGRES_DB_PAGOS=db_pagos

# Cadenas de conexión listas para PostgreSQL
DATABASE_URL_PEDIDOS=postgresql://tienda_admin:tienda_pass_2026@postgres:5432/db_pedidos
DATABASE_URL_PAGOS=postgresql://tienda_admin:tienda_pass_2026@postgres:5432/db_pagos

# MongoDB (Integrante 4: api-resenas)
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DB_RESENAS=db_resenas
MONGO_URI=mongodb://mongo:27017/db_resenas